# Copy this file to `.env` (git-ignored) and fill in real values locally.
# NEVER commit real credentials or API keys.
#
# This pipeline is fully isolated from the production website. It does not
# read the production server's .env or server/service-account-key.json path
# by convention -- you must explicitly point it at credentials here.

# --- Firestore export (read-only) ---
# Path to a service account key JSON file. Recommend using a key for a
# service account with READ-ONLY Firestore IAM permissions dedicated to
# this research pipeline (do not reuse a write-capable production key).
PCK_RESEARCH_GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/research-readonly-key.json

# GCP project ID that hosts the Firestore database to export from.
PCK_RESEARCH_FIRESTORE_PROJECT_ID=your-gcp-project-id

# --- Vertex AI / Gemini adapter ---
# Only needed when running `pck-research infer` with a vertex_gemini run config.
PCK_RESEARCH_VERTEX_PROJECT_ID=your-gcp-project-id
PCK_RESEARCH_VERTEX_LOCATION=us-central1
# Credentials for Vertex calls -- may reuse the same key as above if that
# service account also has Vertex AI User permissions, or use a separate one.
PCK_RESEARCH_VERTEX_GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/research-vertex-key.json

# --- OpenAI-compatible adapter (OpenAI itself, or self-hosted vLLM/TGI/Ollama) ---
# Only needed when running `pck-research infer` with an openai_compatible run config.
PCK_RESEARCH_OPENAI_API_KEY=sk-...
# Base URL: https://api.openai.com/v1 for OpenAI itself, or e.g.
# http://localhost:8000/v1 for a local vLLM/TGI OpenAI-compatible server.
PCK_RESEARCH_OPENAI_BASE_URL=https://api.openai.com/v1
